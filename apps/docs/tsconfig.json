{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler"
  },
  "include": [
    "src",
    "blocks",
    "examples/base/data-table",
    "examples/base/DataTable*.svelte",
    "registry",
    "vite.config.ts"
  ]
}
