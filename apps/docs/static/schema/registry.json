{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sveltery registry manifest",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "registryVersion",
    "styles",
    "baseColors",
    "iconLibraries",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "const": "sveltery"
    },
    "registryVersion": {
      "const": 1
    },
    "styles": {
      "type": "array",
      "items": {
        "enum": [
          "vega",
          "nova",
          "maia",
          "lyra",
          "mira",
          "luma",
          "sera",
          "rhea"
        ]
      }
    },
    "baseColors": {
      "type": "array",
      "items": {
        "enum": [
          "neutral",
          "stone",
          "zinc",
          "mauve",
          "olive",
          "mist",
          "taupe"
        ]
      }
    },
    "iconLibraries": {
      "type": "array",
      "items": {
        "enum": [
          "lucide",
          "tabler",
          "hugeicons",
          "phosphor",
          "remixicon"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "registry:ui",
              "registry:lib",
              "registry:theme",
              "registry:font",
              "registry:base"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
