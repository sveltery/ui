{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sveltery registry item",
  "description": "One installable item of the Sveltery UI registry. The shape follows shadcn-svelte's registry-item schema.",
  "type": "object",
  "required": [
    "name",
    "type",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "registry:ui",
        "registry:lib",
        "registry:theme"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "npm packages, such as cn@^0.2.2."
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other items in this registry, by name."
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target",
          "content"
        ],
        "properties": {
          "type": {
            "const": "registry:ui"
          },
          "target": {
            "type": "string",
            "description": "Path below the project's ui alias."
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "cssVars": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "light": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
