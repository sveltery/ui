{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "components.json",
  "description": "Configuration for the sveltery CLI. The keys match shadcn-svelte's components.json.",
  "type": "object",
  "required": [
    "style",
    "tailwind",
    "aliases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "style": {
      "enum": [
        "vega",
        "nova",
        "maia",
        "lyra",
        "mira",
        "luma",
        "sera",
        "rhea"
      ]
    },
    "iconLibrary": {
      "enum": [
        "lucide",
        "tabler",
        "hugeicons",
        "phosphor",
        "remixicon"
      ]
    },
    "rtl": {
      "type": "boolean"
    },
    "menuColor": {
      "enum": [
        "default",
        "inverted",
        "default-translucent",
        "inverted-translucent"
      ]
    },
    "menuAccent": {
      "enum": [
        "subtle",
        "bold"
      ]
    },
    "tailwind": {
      "type": "object",
      "required": [
        "css",
        "baseColor"
      ],
      "properties": {
        "css": {
          "type": "string"
        },
        "baseColor": {
          "enum": [
            "neutral",
            "stone",
            "zinc",
            "mauve",
            "olive",
            "mist",
            "taupe"
          ]
        }
      }
    },
    "aliases": {
      "type": "object",
      "required": [
        "components",
        "ui",
        "utils"
      ],
      "properties": {
        "components": {
          "type": "string"
        },
        "ui": {
          "type": "string"
        },
        "utils": {
          "type": "string"
        },
        "lib": {
          "type": "string"
        },
        "hooks": {
          "type": "string"
        }
      }
    },
    "registry": {
      "type": "string",
      "description": "The registry root URL. SVELTERY_REGISTRY_URL overrides it."
    },
    "registries": {
      "type": "object",
      "description": "Namespaced registries for `add @namespace/item`. Each value is a URL with `{name}`, or an object with `url`, `params` and `headers`. `${VAR}` reads an environment variable.",
      "propertyNames": {
        "pattern": "^@[a-zA-Z0-9](?:[a-zA-Z0-9-_]*[a-zA-Z0-9])?$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "\\{name\\}"
          },
          {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "\\{name\\}"
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "typescript": {
      "const": true
    }
  }
}
