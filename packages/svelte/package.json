{
  "name": "@sveltery/svelte",
  "version": "0.1.0",
  "description": "Unstyled components for Svelte 5.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltery",
    "headless",
    "unstyled",
    "chat",
    "scroll",
    "form",
    "questionnaire"
  ],
  "homepage": "https://ui.sveltery.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltery/ui.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./message-scroller": {
      "types": "./dist/message-scroller/index.d.ts",
      "svelte": "./dist/message-scroller/index.js",
      "default": "./dist/message-scroller/index.js"
    },
    "./questionnaire": {
      "types": "./dist/questionnaire/index.d.ts",
      "svelte": "./dist/questionnaire/index.js",
      "default": "./dist/questionnaire/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "svelte-package --input src",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "pnpm run build && publint --strict"
  },
  "dependencies": {
    "esm-env": "^1.2.1"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "publint": "0.3.25",
    "svelte": "5.57.1"
  }
}
