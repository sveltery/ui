{
  "name": "@sveltery/input-otp",
  "version": "0.1.0",
  "description": "A one-time password input for Svelte 5, ported from input-otp.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltery",
    "otp",
    "one-time-password",
    "input-otp",
    "headless"
  ],
  "homepage": "https://ui.sveltery.dev/docs/components/input-otp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltery/ui.git",
    "directory": "packages/input-otp"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "svelte-package --input src",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "pnpm run build && publint --strict"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "publint": "0.3.25",
    "svelte": "5.57.1"
  }
}
