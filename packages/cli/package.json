{
  "name": "@sveltery/ui",
  "version": "0.1.1",
  "description": "Add Sveltery UI components to a Svelte app.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltery",
    "shadcn",
    "tailwindcss",
    "cli",
    "components"
  ],
  "homepage": "https://ui.sveltery.dev",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltery/ui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sveltery": "dist/index.js"
  },
  "files": [
    "dist",
    "tailwind.css",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./preset": {
      "types": "./src/preset/index.ts",
      "default": "./src/preset/index.ts"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./preset": {
        "types": "./dist/preset/index.d.ts",
        "default": "./dist/preset/index.js"
      },
      "./tailwind.css": "./tailwind.css",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build && publint --strict",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "cn": "0.2.4",
    "commander": "14.0.3",
    "diff": "9.0.0",
    "magic-string": "0.30.21",
    "package-manager-detector": "1.8.0",
    "postcss": "8.5.28",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "publint": "0.3.25",
    "shadcn": "4.21.1",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
