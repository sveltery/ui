{
  "name": "@sveltery/day-picker",
  "version": "0.1.0",
  "description": "A date picker and calendar for Svelte 5, ported from react-day-picker.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltery",
    "date-picker",
    "calendar",
    "day-picker",
    "headless"
  ],
  "homepage": "https://ui.sveltery.dev/docs/components/calendar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltery/ui.git",
    "directory": "packages/day-picker"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "svelte-package --input src",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "pnpm run build && publint --strict"
  },
  "peerDependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@date-fns/tz": "1.5.0",
    "date-fns": "4.4.0",
    "publint": "0.3.25",
    "svelte": "5.57.1"
  }
}
