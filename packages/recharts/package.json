{
  "name": "@sveltery/recharts",
  "version": "0.1.0",
  "description": "Recharts for Svelte 5: composable SVG charts, ported from recharts.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltery",
    "recharts",
    "charts",
    "svg"
  ],
  "homepage": "https://ui.sveltery.dev/docs/components/chart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltery/ui.git",
    "directory": "packages/recharts"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "svelte-package --input src",
    "check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./test/tsconfig.json",
    "prepack": "pnpm run build && publint --strict"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.0 || 2.x.x",
    "clsx": "^2.1.1",
    "decimal.js-light": "^2.5.1",
    "es-toolkit": "^1.39.3",
    "eventemitter3": "^5.0.1",
    "immer": "^10.1.1",
    "reselect": "5.1.1",
    "tiny-invariant": "^1.3.3",
    "victory-vendor": "^37.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "26.6.3",
    "publint": "0.3.25",
    "svelte": "5.57.1"
  }
}
