{
  "name": "@sveltery/resizable",
  "version": "0.1.0",
  "description": "Resizable panel groups for Svelte 5, ported from react-resizable-panels.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltery",
    "resizable",
    "panels",
    "split-view",
    "headless"
  ],
  "homepage": "https://ui.sveltery.dev/docs/components/resizable",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltery/ui.git",
    "directory": "packages/resizable"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/test/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "svelte": "./dist/index.js",
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepack": "pnpm run build && publint --strict"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "publint": "0.3.25",
    "svelte": "5.57.1"
  }
}
