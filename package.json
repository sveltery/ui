{
  "name": "sveltery-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @sveltery/ui build && pnpm --filter @sveltery/docs build",
    "check": "pnpm -r check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@sveltery/base": "file:.vendor/sveltery-base-0.0.0.tgz",
    "@playwright/test": "1.63.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@base-ui/react": "1.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "class-variance-authority": "0.7.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.71.0"
  },
  "license": "MIT"
}
