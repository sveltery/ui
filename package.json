{
  "name": "sveltery-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter @sveltery/ui build && pnpm --filter @sveltery/docs build",
    "check": "pnpm -r check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hugeicons/core-free-icons": "1.2.1",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@sveltery/base": "github:sveltery/base#96c4a85856c5918bf40c0586a28e8e8ba757e717",
    "@tabler/icons": "3.34.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/jsdom": "30.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.2",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "lucide": "0.474.0",
    "remixicon": "4.7.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
